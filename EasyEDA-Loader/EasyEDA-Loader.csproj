<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>EasyEDA_Loader</RootNamespace>
    <AssemblyName>EasyEDA-Loader</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DevExpressVersion Condition="'$(DevExpressVersion)' == ''">24.1</DevExpressVersion>
    <DevExpressDirectory Condition="'$(DevExpressDirectory)' == ''">Assemblies</DevExpressDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="EasyEdaCommandBridge.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
    <PackageReference Include="SharpCompress" Version="0.50.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StepF3DRenderLib\StepF3DRenderLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Altium.Controls">
      <HintPath>Assemblies\Altium.Controls.dll</HintPath>
    </Reference>
    <Reference Include="Altium.SDK">
      <HintPath>Assemblies\Altium.SDK.dll</HintPath>
    </Reference>
    <Reference Include="Altium.SDK.Interfaces">
      <HintPath>Assemblies\Altium.SDK.Interfaces.dll</HintPath>
    </Reference>
    <Reference Include="Altium.Edp.Interfaces">
      <HintPath>D:\Program files\ADAgile\System\Altium.Edp.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Altium.Dxp.Interfaces">
      <HintPath>D:\Program files\ADAgile\System\Altium.Dxp.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DevExpress.Data.v$(DevExpressVersion)">
      <HintPath>$(DevExpressDirectory)\DevExpress.Data.v$(DevExpressVersion).dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Mvvm.v$(DevExpressVersion)">
      <HintPath>$(DevExpressDirectory)\DevExpress.Mvvm.v$(DevExpressVersion).dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Printing.v$(DevExpressVersion).Core">
      <HintPath>$(DevExpressDirectory)\DevExpress.Printing.v$(DevExpressVersion).Core.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Utils.v$(DevExpressVersion)">
      <HintPath>$(DevExpressDirectory)\DevExpress.Utils.v$(DevExpressVersion).dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraEditors.v$(DevExpressVersion)">
      <HintPath>$(DevExpressDirectory)\DevExpress.XtraEditors.v$(DevExpressVersion).dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Xpf.Core.v$(DevExpressVersion)">
      <HintPath>$(DevExpressDirectory)\DevExpress.Xpf.Core.v$(DevExpressVersion).dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Xpf.Grid.v$(DevExpressVersion).Core">
      <HintPath>$(DevExpressDirectory)\DevExpress.Xpf.Grid.v$(DevExpressVersion).Core.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Xpf.Grid.v$(DevExpressVersion)">
      <HintPath>$(DevExpressDirectory)\DevExpress.Xpf.Grid.v$(DevExpressVersion).dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
